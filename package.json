    "intro.js": "^2.9.3",
    "lodash.set": "^4.3.2",
    "pouchdb": "^8.0.1",
    "tiny-emitter": "^2.0.2",
    "toastr": "^2.1.2",
    "url-search-params": "^0.5.0",
    "v-accordion": "^1.6.0"
  },
