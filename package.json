{
  "name": "ssas-enketo",
  "version": "8.0.0",
  "description": "ssas enketo module",
  "scripts": {
    "serve": "http-server www/",
    "build": "NODE_ENV=production node esbuild.config.js",
    "dev": "NODE_ENV=development node esbuild.config.js --watch",
    "test": "mocha -r @babel/register -r babel-polyfill -r jsdom-global/register 'test/**/*.js'",
    "sass": "npx sass src/sass/survey-print.scss --style compressed > www/build/css/survey-print.css",
    "clean": "rm -rf www/fonts www/build",
    "prepublishOnly": "yarn && yarn clean && yarn build"
  },
  "author": "Imagins",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/swiftmade/ssas-enketo",
  "dependencies": {
    "angular": "1.7.9",
    "axios": "^1.7.6",
    "compressorjs": "^1.0.5",
    "enketo-core": "8.3.0",
    "font-awesome": "4.7",
    "lodash.set": "^4.3.2",
    "pouchdb": "^8.0.1",
    "tiny-emitter": "^2.0.2",
    "toastr": "^2.1.2",
    "url-search-params": "^0.5.0",
    "v-accordion": "^1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.17.9",
    "@babel/preset-env": "^7.16.11",
    "@babel/register": "^7.17.7",
    "axios-mock-adapter": "^2.0.0",
    "babel-polyfill": "^6.26.0",
    "chai": "^4.3.6",
    "esbuild": "^0.19.0",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "jsdom": "^25.0.0",
    "jsdom-global": "^3.0.2",
    "mocha": "^9.2.2",
    "mocha-sinon": "^2.1.2",
    "node-sass": "^9.0.0",
    "sinon": "^18.0.0"
  }
}