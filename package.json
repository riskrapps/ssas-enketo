{
  "name": "ssas-enketo",
  "version": "2.10.0",
  "description": "ssas enketo module",
  "scripts": {
    "serve": "http-server www/",
    "build": "NODE_ENV=production webpack --mode=production && yarn sass",
    "dev": "NODE_ENV=development webpack --mode=development --watch",
    "test": "mocha -r @babel/register -r babel-polyfill -r jsdom-global/register",
    "sass": "npx sass src/sass/survey-print.scss --style compressed > www/build/css/survey-print.css",
    "clean": "rm -rf www/fonts www/build",
    "prepublishOnly": "yarn && yarn clean && yarn build"
  },
